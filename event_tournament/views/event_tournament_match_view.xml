<odoo>
    <record id="event_tournament_match_view_form" model="ir.ui.view">
        <field name="name">event.tournament.match form view</field>
        <field name="model">event.tournament.match</field>
        <field name="arch" type="xml">
            <form string="Match">
                <header>
                    <button
                        name="action_draft"
                        string="Reset to draft"
                        type="object"
                        invisible="state == 'draft'"
                    />
                    <button
                        name="action_done"
                        string="Done"
                        data-hotkey="d"
                        type="object"
                        invisible="state == 'done'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="event_id" readonly="state == 'done'" />
                        <field name="tournament_id" readonly="state == 'done'" />
                        <field
                            name="match_mode_id"
                            invisible="True"
                            readonly="state == 'done'"
                        />
                        <field name="court_id" readonly="state == 'done'" />
                        <field name="time_scheduled_start" readonly="state == 'done'" />
                        <field name="time_scheduled_end" readonly="state == 'done'" />
                        <field
                            name="team_ids"
                            widget="many2many_tags"
                            readonly="state == 'done'"
                            options="{
                                'open': True,
                            }"
                        />
                        <field
                            readonly="state == 'done'"
                            name="set_ids"
                            widget="many2many_tags"
                            context="{'default_match_id': id}"
                        >
                            <list>
                                <field name="name" />
                            </list>
                        </field>
                        <field
                            name="result_ids"
                            readonly="state == 'done'"
                            widget="x2many_2d_matrix"
                            field_x_axis="team_id"
                            field_y_axis="set_id"
                            field_value="score"
                        >
                            <list>
                                <field name="set_id" />
                                <field name="team_id" />
                                <field name="score" />
                            </list>
                        </field>
                    </group>
                    <group invisible="state != 'done'">
                        <field name="winner_team_id" />
                        <field name="time_done" readonly="state == 'done'" />
                        <field name="stats_ids" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="event_tournament_match_view_kanban" model="ir.ui.view">
        <field name="name">event.tournament.match kanban view</field>
        <field name="model">event.tournament.match</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <progressbar
                    field="state"
                    colors="{&quot;done&quot;: &quot;success&quot;, &quot;draft&quot;: &quot;danger&quot;}"
                />
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="d-flex ms-auto">
                                <strong>
                                    <field name="display_name" />
                                </strong>
                                <field
                                    name="state"
                                    widget="state_selection"
                                    class="flex ms-auto"
                                />
                            </div>
                        </div>
                        <div class="row">
                            <div
                                class="text-success"
                                title="Winner"
                                aria-label="Winner"
                            >
                                <i class="fa fa-trophy mr4" role="img" />
                                <field name="winner_team_id" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="text-muted">
                                <field name="tournament_id" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="text-muted" title="Court" aria-label="Court">
                                <i class="fa fa-map-marker mr4" role="img" />
                                <field name="court_id" />
                            </div>
                        </div>
                        <div class="row">
                            <div title="Time start" aria-label="Time start">
                                <i class="fa fa-clock-o mr4" role="img" />
                                <field name="time_scheduled_start" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="event_tournament_match_view_tree" model="ir.ui.view">
        <field name="name">event.tournament.match list view</field>
        <field name="model">event.tournament.match</field>
        <field name="arch" type="xml">
            <list>
                <field name="tournament_id" />
                <field name="court_id" />
                <field name="time_scheduled_start" />
                <field name="team_ids" widget="many2many_tags" />
                <field
                    name="set_ids"
                    widget="many2many_tags"
                    column_invisible="state != 'done'"
                />
                <field name="winner_team_id" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="event_tournament_match_view_calendar" model="ir.ui.view">
        <field name="name">event.tournament.match calendar view</field>
        <field name="model">event.tournament.match</field>
        <field name="arch" type="xml">
            <calendar
                date_start="time_scheduled_start"
                date_stop="time_scheduled_end"
                color="court_id"
            >
                <field name="display_name" />
                <field name="court_id" filters="True" />
            </calendar>
        </field>
    </record>
    <record id="event_tournament_match_view_timeline" model="ir.ui.view">
        <field name="name">event.tournament.match timeline view</field>
        <field name="model">event.tournament.match</field>
        <field name="arch" type="xml">
            <timeline
                date_start="time_scheduled_start"
                date_stop="time_scheduled_end"
                string="Matches"
                default_group_by="court_id"
                event_open_popup="true"
            >
                <field name="team_ids" />
                <templates>
                    <t t-name="timeline-item">
                        <div
                            style="display:flex;justify-content:center;align-items:center;height: 80px; white-space: break-spaces;"
                        >
                            <p t-esc="record.display_name" />
                        </div>
                    </t>
                </templates>
            </timeline>
        </field>
    </record>
    <record id="event_tournament_match_view_search" model="ir.ui.view">
        <field name="name">event.tournament.match search view</field>
        <field name="model">event.tournament.match</field>
        <field name="arch" type="xml">
            <search>
                <field name="tournament_id" />
                <field name="team_ids" />
                <field name="component_ids" />
                <filter string="Court" name="court" context="{'group_by':'court_id'}" />
                <filter
                    string="Components"
                    name="component"
                    context="{'group_by':'component_ids'}"
                />
                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <filter
                    string="Tournament"
                    name="tournament"
                    context="{'group_by':'tournament_id'}"
                />
            </search>
        </field>
    </record>
    <record id="event_tournament_match_action" model="ir.actions.act_window">
        <field name="name">Tournament matches</field>
        <field name="res_model">event.tournament.match</field>
        <field name="view_mode">kanban,timeline,calendar,list,form</field>
    </record>
    <menuitem
        id="event_tournament_match_menu"
        parent="event_tournament_root_menu"
        action="event_tournament_match_action"
    />
</odoo>
