<odoo>
    <record id="view_program_tree" model="ir.ui.view">
        <field name="name">Tree view for appliance program</field>
        <field name="model">appliance.usage.cost.appliance.program</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="duration" widget="float_time" />
                <field name="appliance_id" />
            </tree>
        </field>
    </record>

    <record id="view_program_form" model="ir.ui.view">
        <field name="name">Form view for appliance program</field>
        <field name="model">appliance.usage.cost.appliance.program</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="appliance_id" readonly="True" />
                        <field name="duration" widget="float_time" />
                    </group>
                    <notebook>
                        <page string="Utility Usages">
                            <field name="utility_usage_ids">
                                <tree editable="bottom">
                                    <field name="utility_id" />
                                    <field name="quantity" />
                                    <field
                                        name="utility_uom_id"
                                        groups="uom.group_uom"
                                    />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_programs" model="ir.actions.act_window">
        <field name="name">Programs</field>
        <field name="res_model">appliance.usage.cost.appliance.program</field>
    </record>

    <menuitem id="menu_programs" parent="menu_root_programs" action="action_programs" />
</odoo>
