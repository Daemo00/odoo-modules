<odoo>
    <record id="view_utility_tree" model="ir.ui.view">
        <field name="name">Tree view for utility</field>
        <field name="model">appliance.usage.cost.utility</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="uom_id" />
            </tree>
        </field>
    </record>

    <record id="view_utility_form" model="ir.ui.view">
        <field name="name">Form view for utility</field>
        <field name="model">appliance.usage.cost.utility</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="uom_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_utilities" model="ir.actions.act_window">
        <field name="name">Utilities</field>
        <field name="res_model">appliance.usage.cost.utility</field>
    </record>

    <menuitem
        id="menu_utilities"
        parent="menu_root_utilities"
        action="action_utilities"
    />
</odoo>
